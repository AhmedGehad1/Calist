# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# PyInstaller build output. calist.spec IS tracked — it is the build recipe.
/build/
/dist/

# Calist output — written next to the source forms.
# Root-anchored on purpose: git is case-insensitive on Windows, so an unanchored
# rule would also swallow template/Device List.xlsx, which must stay tracked.
/device list.xlsx

# Completed inspection forms may contain real device and site data;
# never commit them.
*-inspection.xlsx

# ── Credentials ───────────────────────────────────────────────────────────────
# THIS REPOSITORY IS PUBLIC. A Firebase service-account key committed here hands
# anyone on the internet write access to four years of calibration records, and
# it bypasses every security rule in the process.
#
# The key belongs somewhere outside this folder entirely — firebase_export.py
# reads its path from CALIST_FIREBASE_KEY and has no default. These patterns are
# a backstop for the day somebody drops one in here anyway, not the plan.
*serviceaccount*.json
*service-account*.json
*-adminsdk-*.json
firebase-key*.json
medcalpro*.json
/secrets/
.env
.env.*

# Dry-run reports name real hospitals and device serials.
dry-run-*.txt
dry-run-*.json
/forms/
/inspections/

# Local backups
_backup-*/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# Working files for building the automated test sheets. These hold real
# completed inspection forms, vendor service manuals and vendor installers -
# none of which belong in a public repository.
/some automated files/
